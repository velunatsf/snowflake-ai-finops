{
  "name": "FinOps for Snowflake AI",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "Training site",
      "command": "python3 -m http.server 8000 --directory training"
    },
    {
      "name": "Streamlit dashboard",
      "command": ".venv/bin/streamlit run dashboard/streamlit_app.py --server.port 8501 --server.address 0.0.0.0 --server.headless true"
    }
  ],
  "ports": [8000, 8501]
}
